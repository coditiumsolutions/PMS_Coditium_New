@model PMS.Models.Transfer

@{
    ViewData["Title"] = "Edit Transfer";
    var isApproved = string.Equals(Model.WorkFlowStatus?.Trim(), "Approved by Transfer Approval Officer", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.WorkFlowStatus?.Trim(), "Approved", StringComparison.OrdinalIgnoreCase);
    var openAttachmentsTab = ViewBag.OpenAttachmentsTab == true;
    var canEditFields = ViewBag.FieldsEditable as bool? ?? string.Equals(Model.WorkFlowStatus?.Trim(), "Created", StringComparison.OrdinalIgnoreCase);
    string D(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v.Trim();
}
<link rel="stylesheet" href="~/css/transfer-wizard-form.css" asp-append-version="true" />

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Transfer</h2>
    <a asp-action="Details" asp-route-id="@Model.TransferID" class="btn pms-transfer-edit-btn"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
@if (!canEditFields)
{
    <div class="alert alert-info py-2 mb-3">
        Field values are locked after status leaves <strong>Created</strong>. You can only change <strong>Workflow Status</strong>.
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <div asp-validation-summary="All" class="mb-0"></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header border-0 bg-transparent px-3 pt-3 pb-0">
        <h5 class="mb-0 text-dark">@Model.TransferID — Customer: @Model.CustomerID</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" novalidate>
            <input type="hidden" asp-for="TransferID" />
            <input type="hidden" asp-for="CustomerID" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="SellerAttachments" id="SellerAttachments" />
            <input type="hidden" asp-for="BuyerAttachments" id="BuyerAttachments" />
            <input type="hidden" asp-for="SellerBiometric" id="SellerBiometric" />
            <input type="hidden" asp-for="BuyerBiometric" id="BuyerBiometric" />

            <div class="transfer-wizard-form mb-3">
                <div class="row g-2 align-items-start transfer-wizard-row">
                    <div class="col-md-2 transfer-wizard-title"><label>Current Status</label></div>
                    <div class="col-md-4">
                        <div class="transfer-wizard-value transfer-wizard-value--status">@(ViewBag.CurrentWorkflowStatus as string ?? Model.WorkFlowStatus ?? "—")</div>
                    </div>
                    <div class="col-md-2 transfer-wizard-title"><label>Customer ID</label></div>
                    <div class="col-md-4"><div class="transfer-wizard-value">@Model.CustomerID</div></div>
                </div>
                <div class="row g-2 align-items-start transfer-wizard-row">
                    <div class="col-md-2 transfer-wizard-title"><label asp-for="WorkFlowStatus">Next Status</label></div>
                    <div class="col-md-4">
                        @{
                            var workflowOptions = ViewBag.WorkflowStatuses as string[] ?? Array.Empty<string>();
                            var selectedWorkflow = Model.WorkFlowStatus;
                        }
                        <select asp-for="WorkFlowStatus" class="form-select transfer-wizard-field transfer-wizard-field--status" id="WorkFlowStatus">
                            @foreach (var s in workflowOptions)
                            {
                                if (string.Equals(s, selectedWorkflow, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@s" selected>@s</option>
                                }
                                else
                                {
                                    <option value="@s">@s</option>
                                }
                            }
                        </select>
                        @if (!string.IsNullOrWhiteSpace(ViewBag.NextWorkflowStatus as string))
                        {
                            <small class="text-muted">Next step available: <strong>@ViewBag.NextWorkflowStatus</strong>. Approved by Transfer Approval Officer locks the record and updates the customer file.</small>
                        }
                        else
                        {
                            <small class="text-muted">No further status steps available.</small>
                        }
                        <span asp-validation-for="WorkFlowStatus" class="text-danger small d-block"></span>
                    </div>
                    <div class="col-md-2 transfer-wizard-title"></div>
                    <div class="col-md-4"></div>
                </div>
            </div>

            <ul class="nav nav-tabs customer-tabs" id="editTabs" role="tablist">
                <li class="nav-item"><button class="nav-link @(openAttachmentsTab ? "" : "active")" type="button" data-bs-toggle="tab" data-bs-target="#seller" role="tab">Seller</button></li>
                <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#buyer" role="tab">Buyer</button></li>
                <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#payment" role="tab">Payment & Fee</button></li>
                <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#comments" role="tab">Comments</button></li>
                <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#newJointOwners" role="tab">New Joint Owners</button></li>
                <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#workflowHistory" role="tab">Workflow History</button></li>
                <li class="nav-item"><button class="nav-link @(openAttachmentsTab ? "active" : "")" type="button" data-bs-toggle="tab" data-bs-target="#attachments" role="tab"><i class="fas fa-paperclip me-1"></i>Attachments</button></li>
            </ul>
            <div class="tab-content border border-top-0 p-3" id="editTabContent">
                <div class="tab-pane fade @(openAttachmentsTab ? "" : "show active")" id="seller" role="tabpanel">
                    <div class="transfer-wizard-form @(canEditFields ? "" : "transfer-wizard-form--readonly")">
                        @if (canEditFields)
                        {
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="SellerName">Seller Name</label></div>
                                <div class="col-md-4">
                                    <input asp-for="SellerName" id="SellerName" class="form-control transfer-wizard-field" placeholder="Letters only" />
                                    <span asp-validation-for="SellerName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="SellerFatherName">Son/D/W/o</label></div>
                                <div class="col-md-4">
                                    <input asp-for="SellerFatherName" id="SellerFatherName" class="form-control transfer-wizard-field" placeholder="Letters only" />
                                    <span asp-validation-for="SellerFatherName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="SellerCNIC">CNIC</label></div>
                                <div class="col-md-4">
                                    <input asp-for="SellerCNIC" id="SellerCNIC" class="form-control transfer-wizard-field" placeholder="XXXXX-XXXXXXX-X" maxlength="15" />
                                    <small class="text-muted">Digits only — hyphens auto-inserted</small>
                                    <span asp-validation-for="SellerCNIC" class="text-danger small d-block"></span>
                                </div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="SellerContact">Contact</label></div>
                                <div class="col-md-4">
                                    <input asp-for="SellerContact" id="SellerContact" class="form-control transfer-wizard-field" placeholder="Digits and + only" />
                                    <span asp-validation-for="SellerContact" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="SellerAddress">Address</label></div>
                                <div class="col-md-10"><input asp-for="SellerAddress" class="form-control transfer-wizard-field" /></div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>Seller Name</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.SellerName)</div></div>
                                <div class="col-md-2 transfer-wizard-title"><label>Son/D/W/o</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.SellerFatherName)</div></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>CNIC</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.SellerCNIC)</div></div>
                                <div class="col-md-2 transfer-wizard-title"><label>Contact</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.SellerContact)</div></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>Address</label></div>
                                <div class="col-md-10"><div class="transfer-wizard-value">@D(Model.SellerAddress)</div></div>
                            </div>
                        }
                    </div>
                </div>
                <div class="tab-pane fade" id="buyer" role="tabpanel">
                    <div class="transfer-wizard-form @(canEditFields ? "" : "transfer-wizard-form--readonly")">
                        @if (canEditFields)
                        {
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerName">Full Name <span class="text-danger">*</span></label></div>
                                <div class="col-md-4">
                                    <input asp-for="BuyerName" id="BuyerName" class="form-control transfer-wizard-field" placeholder="Enter full name" required />
                                    <span asp-validation-for="BuyerName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerFatherName">Son/D/W/o</label></div>
                                <div class="col-md-4">
                                    <input asp-for="BuyerFatherName" id="BuyerFatherName" class="form-control transfer-wizard-field" placeholder="Letters only" />
                                    <span asp-validation-for="BuyerFatherName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerCNIC">National ID (CNIC)</label></div>
                                <div class="col-md-4">
                                    <input asp-for="BuyerCNIC" id="BuyerCNIC" class="form-control transfer-wizard-field" placeholder="XXXXX-XXXXXXX-X" maxlength="15" />
                                    <small class="text-muted">Format: 11111-1111111-1</small>
                                    <span asp-validation-for="BuyerCNIC" class="text-danger small d-block"></span>
                                    <span id="buyerCnicError" class="text-danger small d-none"></span>
                                </div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerPassportNo">Passport Number</label></div>
                                <div class="col-md-4">
                                    <input asp-for="BuyerPassportNo" id="BuyerPassportNo" class="form-control transfer-wizard-field" placeholder="Min 5 characters if no CNIC" />
                                    <small class="text-muted">Min 5 characters if no CNIC</small>
                                    <span asp-validation-for="BuyerPassportNo" class="text-danger small d-block"></span>
                                    <span id="buyerPassportError" class="text-danger small d-none"></span>
                                </div>
                            </div>
                            <div id="buyerCnicPassportRule" class="row transfer-wizard-row d-none">
                                <div class="col-12">
                                    <div class="alert alert-warning small py-2 mb-0"><i class="fas fa-exclamation-triangle me-1"></i>Either Buyer CNIC or Passport Number must be provided.</div>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerDOB">Date of Birth</label></div>
                                <div class="col-md-4">
                                    <input asp-for="BuyerDOB" id="BuyerDOB" type="date" class="form-control transfer-wizard-field" lang="en-GB" value="@(Model.BuyerDOB?.ToString("yyyy-MM-dd") ?? "1990-01-01")" />
                                    <span asp-validation-for="BuyerDOB" class="text-danger small"></span>
                                </div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerGender">Gender</label></div>
                                <div class="col-md-4">
                                    <select asp-for="BuyerGender" class="form-select transfer-wizard-field">
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <span asp-validation-for="BuyerGender" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerNationality">Nationality</label></div>
                                <div class="col-md-4">
                                    <input asp-for="BuyerNationality" class="form-control transfer-wizard-field" list="nationalityList-transfer-edit" autocomplete="off" placeholder="Select or type" />
                                    <datalist id="nationalityList-transfer-edit">
                                        @if (ViewBag.Nationalities != null)
                                        {
                                            foreach (var nationality in (IEnumerable<string>)ViewBag.Nationalities)
                                            {
                                                <option value="@nationality"></option>
                                            }
                                        }
                                    </datalist>
                                    <span asp-validation-for="BuyerNationality" class="text-danger small"></span>
                                </div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerEmail">Email Address</label></div>
                                <div class="col-md-4">
                                    <input asp-for="BuyerEmail" type="email" class="form-control transfer-wizard-field" />
                                    <span asp-validation-for="BuyerEmail" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row transfer-wizard-row transfer-wizard-row--section">
                                <div class="col-12 transfer-wizard-section">Contact Information</div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerPhone">Phone <span class="text-danger">*</span></label></div>
                                <div class="col-md-4">
                                    <input asp-for="BuyerPhone" id="BuyerPhone" class="form-control transfer-wizard-field" required />
                                    <span asp-validation-for="BuyerPhone" class="text-danger small"></span>
                                </div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerMobile">Mobile <span class="text-danger">*</span></label></div>
                                <div class="col-md-4">
                                    <input asp-for="BuyerMobile" id="BuyerMobile" class="form-control transfer-wizard-field" required />
                                    <span asp-validation-for="BuyerMobile" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerMobile2">Mobile 2</label></div>
                                <div class="col-md-4">
                                    <input asp-for="BuyerMobile2" id="BuyerMobile2" class="form-control transfer-wizard-field" />
                                    <small class="text-muted">Optional; must differ from Phone and Mobile</small>
                                    <span asp-validation-for="BuyerMobile2" class="text-danger small"></span>
                                </div>
                                <div class="col-md-2 transfer-wizard-title"></div>
                                <div class="col-md-4"></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerMailingAddress">Mailing Address <span class="text-danger">*</span></label></div>
                                <div class="col-md-10">
                                    <textarea asp-for="BuyerMailingAddress" class="form-control transfer-wizard-field" rows="2" required></textarea>
                                    <span asp-validation-for="BuyerMailingAddress" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerPermanentAddress">Permanent Address</label></div>
                                <div class="col-md-10">
                                    <textarea asp-for="BuyerPermanentAddress" class="form-control transfer-wizard-field" rows="2"></textarea>
                                    <span asp-validation-for="BuyerPermanentAddress" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerCity">City <span class="text-danger">*</span></label></div>
                                <div class="col-md-4">
                                    <select asp-for="BuyerCity" class="form-select transfer-wizard-field" required>
                                        <option value="">Select City</option>
                                        @if (ViewBag.Cities != null)
                                        {
                                            foreach (var city in (IEnumerable<string>)ViewBag.Cities)
                                            {
                                                <option value="@city">@city</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="BuyerCity" class="text-danger small"></span>
                                </div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BuyerCountry">Country <span class="text-danger">*</span></label></div>
                                <div class="col-md-4">
                                    <select asp-for="BuyerCountry" class="form-select transfer-wizard-field" required>
                                        <option value="">Select Country</option>
                                        @if (ViewBag.Countries != null)
                                        {
                                            foreach (var country in (IEnumerable<string>)ViewBag.Countries)
                                            {
                                                <option value="@country">@country</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="BuyerCountry" class="text-danger small"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>Full Name</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerName)</div></div>
                                <div class="col-md-2 transfer-wizard-title"><label>Son/D/W/o</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerFatherName)</div></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>National ID (CNIC)</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerCNIC)</div></div>
                                <div class="col-md-2 transfer-wizard-title"><label>Passport Number</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerPassportNo)</div></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>Date of Birth</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@(Model.BuyerDOB?.ToString("dd-MM-yyyy") ?? "—")</div></div>
                                <div class="col-md-2 transfer-wizard-title"><label>Gender</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerGender)</div></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>Nationality</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerNationality)</div></div>
                                <div class="col-md-2 transfer-wizard-title"><label>Email Address</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerEmail)</div></div>
                            </div>
                            <div class="row transfer-wizard-row transfer-wizard-row--section">
                                <div class="col-12 transfer-wizard-section">Contact Information</div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>Phone</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerPhone)</div></div>
                                <div class="col-md-2 transfer-wizard-title"><label>Mobile</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerMobile)</div></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>Mobile 2</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerMobile2)</div></div>
                                <div class="col-md-2 transfer-wizard-title"></div>
                                <div class="col-md-4"></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>Mailing Address</label></div>
                                <div class="col-md-10"><div class="transfer-wizard-value">@D(Model.BuyerMailingAddress)</div></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>Permanent Address</label></div>
                                <div class="col-md-10"><div class="transfer-wizard-value">@D(Model.BuyerPermanentAddress)</div></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label>City</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerCity)</div></div>
                                <div class="col-md-2 transfer-wizard-title"><label>Country</label></div>
                                <div class="col-md-4"><div class="transfer-wizard-value">@D(Model.BuyerCountry)</div></div>
                            </div>
                        }
                    </div>
                </div>
                <div class="tab-pane fade" id="payment" role="tabpanel">
                    @{
                        var bankNamesEdit = ViewBag.BankNames as IEnumerable<string> ?? Array.Empty<string>();
                        var currentBankEdit = Model.BankName?.Trim() ?? "";
                    }
                    <div class="transfer-wizard-form @(canEditFields ? "" : "transfer-wizard-form--readonly")">
                        @if (canEditFields)
                        {
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="TransferFeeDue">Transfer Fee Due</label></div>
                                <div class="col-md-4"><input asp-for="TransferFeeDue" type="number" step="0.01" class="form-control transfer-wizard-field" /></div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="TransferFeePaid">Transfer Fee Paid</label></div>
                                <div class="col-md-4"><input asp-for="TransferFeePaid" type="number" step="0.01" class="form-control transfer-wizard-field" /></div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="PaymentDate">Payment Date</label></div>
                                <div class="col-md-4"><input asp-for="PaymentDate" type="date" class="form-control transfer-wizard-field" /></div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="PaymentMode">Payment Mode</label></div>
                                <div class="col-md-4">
                                    <select asp-for="PaymentMode" class="form-select transfer-wizard-field">
                                        <option value="">Select Payment Mode</option>
                                        @if (ViewBag.PaymentMethods != null)
                                        {
                                            @foreach (var pm in (IEnumerable<string>)ViewBag.PaymentMethods)
                                            {
                                                <option value="@pm">@pm</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="PaymentChallanNo">Challan No</label></div>
                                <div class="col-md-4"><input asp-for="PaymentChallanNo" class="form-control transfer-wizard-field" /></div>
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="BankName">Bank name</label></div>
                                <div class="col-md-4">
                                    <select asp-for="BankName" class="form-select transfer-wizard-field">
                                        <option value="">Select bank</option>
                                        @if (!string.IsNullOrEmpty(currentBankEdit) && !bankNamesEdit.Any(b => string.Equals(b, currentBankEdit, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <option value="@currentBankEdit" selected>@currentBankEdit</option>
                                        }
                                        @foreach (var bank in bankNamesEdit)
                                        {
                                            if (string.Equals(bank, currentBankEdit, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <option value="@bank" selected>@bank</option>
                                            }
                                            else
                                            {
                                                <option value="@bank">@bank</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start transfer-wizard-row">
                                <div class="col-md-2 transfer-wizard-title"><label asp-for="PaymentDetails">Payment details</label></div>
                                <div class="col-md-10"><textarea asp-for="PaymentDetails" class="form-control transfer-wizard-field" rows="2"></textarea></div>
                            </div>
                        }

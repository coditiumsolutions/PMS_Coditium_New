@model PMS.Models.Transfer
@{
    ViewData["Title"] = "Transfer Details";
    var isApproved = string.Equals(Model.WorkFlowStatus?.Trim(), "Approved by Transfer Approval Officer", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.WorkFlowStatus?.Trim(), "Approved", StringComparison.OrdinalIgnoreCase);
    var isInitiated = string.Equals(Model.WorkFlowStatus?.Trim(), "Created", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.WorkFlowStatus?.Trim(), "Initiated", StringComparison.OrdinalIgnoreCase);
    string D(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v.Trim();
}
<link rel="stylesheet" href="~/css/transfer-wizard-form.css" asp-append-version="true" />
<div style="display:none;">@Html.AntiForgeryToken()</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3">
        <span class="badge bg-light text-dark px-3 py-2">
            <i class="fas fa-exchange-alt me-2" style="color: #6f42c1;"></i>
            <strong>@Model.TransferID</strong>
        </span>
        <span class="badge @(isApproved ? "bg-success" : "bg-warning")">@(Model.WorkFlowStatus ?? "—")</span>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (!isApproved)
        {
            <a asp-action="Edit" asp-route-id="@Model.TransferID" class="btn pms-transfer-details-btn">
                <i class="fas fa-edit me-1"></i>Edit
            </a>
        }
        @if (ViewBag.CanDelete == true && isInitiated)
        {
            <form asp-action="Delete" asp-route-id="@Model.TransferID" method="post" class="d-inline" onsubmit="return confirm('Delete this transfer?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    <i class="fas fa-trash me-2"></i>Delete
                </button>
            </form>
        }
        @if (isApproved)
        {
            <a asp-action="TransferLetter" asp-route-id="@Model.TransferID" target="_blank" class="btn btn-sm btn-success" title="Transfer Letter">
                <i class="fas fa-file-alt"></i>
            </a>
        }
        <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerID" class="btn pms-transfer-details-btn">
            <i class="fas fa-user me-1"></i>Customer File
        </a>
        <a asp-action="Index" class="btn pms-transfer-details-btn">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


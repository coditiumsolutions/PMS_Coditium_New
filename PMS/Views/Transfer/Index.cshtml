@model IEnumerable<PMS.Models.Transfer>

@{
    ViewData["Title"] = "Transfers";
    ViewData["ListingHideToolbarActions"] = true;
    var transferCount = Model?.Count() ?? 0;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-2 small" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show py-2 mb-2 small" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="pms-transfer-listing pms-listing-page">
    <form method="get" asp-action="Index" class="mb-2">
        <div class="pms-transfer-search-wrap pms-listing-search-wrap pms-transfer-search-panel">
            <div class="row g-1 align-items-center flex-lg-nowrap pms-transfer-search-fields">
                <div class="col-12 col-md-5 col-lg-3">
                    <div class="pms-compact-field">
                        <label for="customerIdFilter" class="visually-hidden">Customer ID</label>
                        <input type="text"
                               name="customerIdFilter"
                               id="customerIdFilter"
                               class="form-control"
                               placeholder="Customer ID"
                               aria-label="Customer ID"
                               value="@ViewBag.CustomerIdFilter" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <div class="pms-compact-field pms-select-dropdown">
                        <label for="workflowFilter" class="visually-hidden">Workflow</label>
                        <select name="workflowFilter" id="workflowFilter" class="form-select" onchange="this.form.submit()" aria-label="Workflow">
                            <option value="">All Workflows</option>
                            @if (ViewBag.WorkflowStatuses != null)
                            {
                                foreach (var s in (string[])ViewBag.WorkflowStatuses)
                                {
                                    <option value="@s" selected="@(ViewBag.WorkflowFilter == s)">@s</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-12 col-lg-auto">
                    <div class="pms-compact-field pms-transfer-search-actions">
                        <div class="d-flex flex-nowrap gap-2 align-items-center">
                            <button type="submit" class="btn btn-sm pms-transfer-action-btn pms-transfer-action-btn--search">
                                <i class="bi bi-search me-1" aria-hidden="true"></i>Search
                            </button>
                            <partial name="_OperationsDropdown" />
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg ms-lg-auto text-lg-end">
                    <span class="badge rounded-pill pms-record-badge">@transferCount record@(transferCount == 1 ? "" : "s")</span>
                </div>
            </div>
        </div>
    </form>

    <div class="card pms-grid-card pms-listing-flat pms-saas-grid pms-transfer-grid mb-2">
        <div class="card-body py-2">
            <div class="table-responsive pms-saas-table-wrap">
                <table class="table pms-saas-table" id="transfersTable">
                    <thead>
                        <tr>
                            <th>Customer ID</th>
                            <th>Project</th>
                            <th>Seller</th>
                            <th>Buyer</th>
                            <th>Fee Due</th>
                            <th>Fee Paid</th>
                            <th class="pms-transfer-col-workflow">Workflow</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr class="pms-transfer-row" data-href="@Url.Action("Details", new { id = t.TransferID })">
                                <td data-label="Customer ID">@(t.CustomerID ?? "—")</td>
                                <td data-label="Project">
                                    @(t.Customer?.PaymentPlan?.Project?.ProjectName ?? "—")
                                </td>
                                <td data-label="Seller"><span class="pms-cell-truncate" title="@t.SellerName">@(t.SellerName ?? "—")</span></td>
                                <td data-label="Buyer"><span class="pms-cell-truncate" title="@t.BuyerName">@(t.BuyerName ?? "—")</span></td>
                                <td data-label="Fee Due">@(t.TransferFeeDue?.ToString("N2") ?? "—")</td>
                                <td data-label="Fee Paid">@(t.TransferFeePaid?.ToString("N2") ?? "—")</td>
                                <td data-label="Workflow" class="pms-transfer-col-workflow">@(t.WorkFlowStatus ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Pull search section up — remove extra top gap */
    .content-body:has(.pms-transfer-listing) {
        padding-top: 0.5rem !important;
    }

    .pms-transfer-listing {
        margin-top: 0;
    }

    .pms-transfer-search-panel {
        padding: 0.55rem 0.85rem !important;
        background: #e8eef8 !important;
        border: 1px solid #c5d0e0 !important;
        border-radius: 10px;
    }

    .pms-transfer-search-fields {
        margin-top: 0 !important;
        align-items: center !important;
    }

    .pms-transfer-listing .pms-transfer-search-panel .form-label:not(.visually-hidden) {
        display: none !important;
    }

    .pms-transfer-listing .pms-transfer-search-wrap .form-control,
    .pms-transfer-listing .pms-transfer-search-wrap .form-select {
        min-height: 34px;
        height: 34px;
        padding: 0.25rem 0.65rem;
        font-size: 0.8125rem;
        border-radius: 0;
    }

    .pms-transfer-listing .pms-transfer-action-btn,
    .pms-transfer-listing .pms-listing-operations-btn {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 7.5rem !important;
        min-width: 7.5rem !important;
        max-width: 7.5rem !important;
        height: 34px !important;
        min-height: 34px !important;
        padding: 0.25rem 0.75rem !important;
        border-radius: 0 !important;
        font-weight: 600;
        font-size: 0.8125rem;
        line-height: 1.2;
        border: 1px solid transparent;
        color: #fff !important;
        white-space: nowrap;
        flex: 0 0 7.5rem !important;
    }

    .pms-transfer-listing .pms-transfer-action-btn--search {
        background-color: #CA7E2A !important;
        border-color: #b56f24 !important;
    }

    .pms-transfer-listing .pms-transfer-action-btn--search:hover,
    .pms-transfer-listing .pms-transfer-action-btn--search:focus {
        background-color: #b56f24 !important;
        border-color: #a06320 !important;
        color: #fff !important;
    }

    .pms-transfer-listing .pms-listing-operations-btn {
        background-color: #343E19 !important;
        border-color: #2a3214 !important;
    }

    .pms-transfer-listing .pms-listing-operations-btn:hover,
    .pms-transfer-listing .pms-listing-operations-btn:focus,
    .pms-transfer-listing .pms-listing-operations-btn.show {
        background-color: #2a3214 !important;
        border-color: #222910 !important;
        color: #fff !important;
    }

    .pms-transfer-listing .pms-transfer-grid,
    .pms-transfer-listing .pms-transfer-grid .card-body,
    .pms-transfer-listing .pms-transfer-grid .pms-saas-table-wrap,
    .pms-transfer-listing .pms-transfer-grid .pms-saas-table {
        background: #fff !important;
    }

    .pms-transfer-listing .pms-saas-table thead th {
        font-size: 0.8125rem !important;
        font-weight: 400 !important;
        text-transform: none !important;
        letter-spacing: normal !important;
        background-color: #fff !important;
        color: #000 !important;
        border: none !important;
        border-bottom: 2px solid #1d4ed8 !important;
        padding: 0.65rem 1rem !important;
        cursor: default !important;
    }

    .pms-transfer-listing .pms-saas-table thead th:hover {
        background-color: #fff !important;
        color: #000 !important;
    }

    .pms-transfer-listing .pms-saas-table thead th.sorting,
    .pms-transfer-listing .pms-saas-table thead th.sorting_asc,
    .pms-transfer-listing .pms-saas-table thead th.sorting_desc,
    .pms-transfer-listing .pms-saas-table thead th.sorting_asc_disabled,
    .pms-transfer-listing .pms-saas-table thead th.sorting_desc_disabled {
        background-image: none !important;
        cursor: default !important;
    }

    .pms-transfer-listing .pms-saas-table,
    .pms-transfer-listing .pms-saas-table tbody td {
        color: #000 !important;
        font-weight: 400 !important;
        font-style: normal !important;
    }

    .pms-transfer-listing .pms-saas-table tbody tr,
    .pms-transfer-listing .pms-saas-table tbody tr:nth-child(even),
    .pms-transfer-listing .pms-saas-table tbody tr:hover {
        background-color: #fff !important;
        box-shadow: none !important;
    }

    .pms-transfer-listing .pms-saas-table tbody td {
        border: none !important;
        border-bottom: 1px solid #1d4ed8 !important;
        background: #fff !important;
    }

    .pms-transfer-listing .pms-saas-table th.pms-transfer-col-workflow,
    .pms-transfer-listing .pms-saas-table td.pms-transfer-col-workflow {
        min-width: 9.5rem;
        width: 12%;
        white-space: nowrap;
        max-width: none;
    }

    .pms-transfer-listing .pms-transfer-row {
        cursor: pointer;
    }

    .pms-transfer-listing .dataTables_length {
        display: none !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            PmsListingDataTable.init('#transfersTable', {
                ordering: false,
                order: [],
                lengthChange: false,
                pageLength: 20,
                dom: 'rtip'
            });
            PmsListingDataTable.bindRowNavigation('#transfersTable', { rowSelector: 'tr.pms-transfer-row' });
        });
    </script>
}
